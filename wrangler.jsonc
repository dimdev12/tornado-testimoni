{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tornado-testimoni",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "db-testimoni",
			"database_id": "6bf0e6d7-f2af-43fd-a50c-faa8e37ff5cf",
		}
	]
}